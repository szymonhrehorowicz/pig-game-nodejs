<!-- Top Scores - history of games -->
<div class="wrapper clearfix games-history">
    <h1>TOP SCORES:</h1>
    <div class="lsInput">
        <div class="cols">
            <h2>Winner:</h2>
            <div class="lsPlayer"></div>
        </div>
        <div class="cols">
            <h2>Score:</h2>
            <div class="lsScore"></div>
        </div>
    </div>
    <form action="/" method="GET">
        <button class="btn-back" type="submit"><i></i>Back</button>
    </form>
    <form action="/games" method="GET">
        <button class="btn-clear" type="submit"><i></i><b>Clear</b></button>
    </form>
</div>

<script src="/public/js/history.js"></script>